{
  "name": "sosumi-mcp",
  "version": "1.0.6",
  "description": "A local stdio MCP server that renders Apple documentation as Markdown",
  "license": "MIT",
  "author": "NSHipster and Austin Traver",
  "repository": {
    "type": "git",
    "url": "https://github.com/austintraver/sosumi-mcp.git"
  },
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "pnpm run typecheck && node scripts/build-stdio-bundle.mjs",
    "dev": "tsx src/stdio.ts",
    "pack:mcpb": "pnpm run build && pnpm run stage:mcpb && mcpb validate artifacts/stage && mcpb pack artifacts/stage artifacts/sosumi-mcp-1.0.6.mcpb",
    "start": "pnpm run build && node dist/stdio.js",
    "stage:mcpb": "node scripts/stage-mcpb.mjs",
    "verify:mcpb": "node scripts/verify-mcpb.mjs artifacts/sosumi-mcp-1.0.6.mcpb",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "test": "vitest run",
    "test:search:live": "SOSUMI_LIVE_SEARCH=1 vitest run tests/search.live.test.ts",
    "test:watch": "vitest",
    "format": "biome check --write --linter-enabled=false .",
    "lint": "biome check --formatter-enabled=false .",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "2.2.2",
    "@types/node": "22.18.12",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
